{
  "name": "acctx",
  "version": "0.1.0",
  "description": "acctx: switch between accounts for developer CLIs (Vercel, Convex, ...)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoopast/acctx.git"
  },
  "homepage": "https://github.com/Zoopast/acctx#readme",
  "bugs": {
    "url": "https://github.com/Zoopast/acctx/issues"
  },
  "type": "module",
  "bin": {
    "acctx": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/cli.js",
    "test": "pnpm build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "keywords": [
    "vercel",
    "convex",
    "github",
    "supabase",
    "cloudflare",
    "clerk",
    "account",
    "switch",
    "cli"
  ],
  "author": "Gabriel San Martin",
  "packageManager": "pnpm@11.5.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
