{
  "name": "acctx",
  "version": "0.1.0",
  "description": "acctx: switch between accounts for developer CLIs (Vercel, Convex, ...)",
  "type": "module",
  "bin": {
    "acctx": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/cli.js",
    "test": "pnpm build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "keywords": [
    "vercel",
    "convex",
    "github",
    "supabase",
    "cloudflare",
    "clerk",
    "account",
    "switch",
    "cli"
  ]
}
